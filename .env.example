# Backend
DATABASE_URL=postgresql+psycopg://jidoka:jidoka@localhost:5432/jidoka
JWT_SECRET_KEY=change-me-in-production
BACKEND_URL=http://localhost:8000
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# Production-only: GitHub username/org that owns the GHCR image.
# Used by compose.prod.yaml to pull ghcr.io/${GITHUB_OWNER}/jidoka-backend:latest.
GITHUB_OWNER=your-github-username

# OAuth providers (leave blank to disable the buttons)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL of the Next.js frontend; used for the post-OAuth redirect.
FRONTEND_URL=http://localhost:3000

# Frontend
BACKEND_URL=http://localhost:8000
