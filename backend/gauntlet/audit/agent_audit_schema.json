{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jidoka.dev/schemas/agent-audit.json",
  "title": "Agent Audit Trace",
  "description": "Structured log of a single HITL agent run for reviewer consumption.",
  "type": "object",
  "required": ["thread_id", "timestamp", "user_message"],
  "properties": {
    "thread_id": {
      "type": "string",
      "format": "uuid",
      "description": "LangGraph thread identifier for this run."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when the trace was emitted."
    },
    "user_message": {
      "type": "string",
      "description": "The message the user sent to the agent."
    },
    "proposed_changes": {
      "type": "array",
      "description": "Changes presented to the user for approval.",
      "items": {
        "type": "object",
        "required": ["type", "title"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["create_task"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": ["string", "null"]
          },
          "column_id": {
            "type": "string",
            "enum": ["backlog", "todo", "in_progress", "done"]
          },
          "project_id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "checked"],
              "properties": {
                "text": {
                  "type": "string"
                },
                "checked": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "approval_decision": {
      "type": "string",
      "enum": ["pending", "approved", "rejected"],
      "description": "User's response to the proposed diff."
    },
    "applied_changes": {
      "type": "array",
      "description": "Changes actually persisted after approval.",
      "items": {
        "type": "object",
        "required": ["type", "id", "title"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["create_task"]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "column_id": {
            "type": "string"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "description": "Errors surfaced during the run.",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "node": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "tool_call": {
            "type": "object"
          }
        }
      }
    }
  }
}
